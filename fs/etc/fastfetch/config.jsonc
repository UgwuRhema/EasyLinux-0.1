{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/etc/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 0,
      "right": 4
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
	"font",
    "cpu",
    "memory",
    "swap",
    "disk",
    "processes",
    "loadavg",
	"locale",
    "break",
    "colors"
  ]
}
